# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# Judging tier. Without this key every run falls back to lexical word overlap,
# which is much weaker — see "Judging engine" in the README.
OPENAI_API_KEY=

# Your email address. Not a secret, but worth setting: Crossref and OpenAlex
# put callers who identify themselves on a faster, more reliable pool, and
# Unpaywall — the broadest source of open-access full text — refuses to answer
# without it. Left blank, Unpaywall is skipped entirely and more references
# come back abstract-only. This is the default; a single run can override it
# from the "Contact email" field under Advanced settings.
CITECHECK_CONTACT_EMAIL=

# Set to "off" to skip the model entirely and use lexical scoring only.
CITECHECK_LLM=

# Model override (optional). Needs to support structured outputs.
CITECHECK_OPENAI_MODEL=gpt-4o

# For Azure or any OpenAI-compatible gateway (optional)
OPENAI_BASE_URL=

# Set this only when the app is reachable from outside localhost, and then
# always. It puts a single shared password in front of every route, so a link
# can be handed to someone who has no account. Left blank the app is open, which
# is right for 127.0.0.1 and wrong for anywhere a stranger can reach — every
# upload spends against the model key above.
CITECHECK_PASSWORD=
CITECHECK_USERNAME=client
