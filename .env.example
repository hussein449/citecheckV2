# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# Judging tier. Set either key (or both). Claude wins when both are present
# unless CITECHECK_LLM says otherwise.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Your email address. Not a secret, but worth setting: Crossref and OpenAlex
# put callers who identify themselves on a faster, more reliable pool, and
# Unpaywall — the broadest source of open-access full text — refuses to answer
# without it. Left blank, Unpaywall is skipped entirely and more references
# come back abstract-only.
CITECHECK_CONTACT_EMAIL=

# Force a specific engine: claude | openai | off
# "off" skips the model entirely and uses lexical scoring only.
CITECHECK_LLM=

# Model overrides (optional)
CITECHECK_OPENAI_MODEL=gpt-4o
CITECHECK_CLAUDE_MODEL=claude-opus-5

# For Azure or any OpenAI-compatible gateway (optional)
OPENAI_BASE_URL=
